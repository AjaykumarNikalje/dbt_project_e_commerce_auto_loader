  create or replace materialized view `retail_analytics_poc_strm_tab`.`dbt_retail_streaming_poc`.`gld_customer_summary`
    
  (
    
      `customer_id` int COMMENT 'Unique customer identifier.',
    
      `customer_name` string COMMENT 'Customer full name.',
    
