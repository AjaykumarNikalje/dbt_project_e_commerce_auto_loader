  create or replace materialized view `retail_analytics_poc_strm_tab`.`dbt_retail_streaming_poc`.`gld_daily_sales`
    
  (
    
      `order_date` date COMMENT 'Order creation date; one row per date with orders.',
    
      `total_orders` bigint COMMENT 'Count of all orders across all statuses.',
    
      `placed_orders` bigint COMMENT 'Count of orders currently in PLACED status.',
    
      `completed_orders` bigint COMMENT 'Count of completed orders.',
    
      `completed_sales_amount` decimal(28,2) COMMENT 'Sum of completed order amounts, grouped by order creation date.',
    
      `cancelled_orders` bigint COMMENT 'Count of cancelled orders.',
    
      `cancelled_order_amount` decimal(28,2) COMMENT 'Sum of cancelled order amounts, grouped by order creation date.',
    
      `refunded_orders` bigint COMMENT 'Count of refunded orders.',
    
      `refunded_order_amount` decimal(28,2) COMMENT 'Sum of refunded order amounts, grouped by order creation date; not actual refund transactions.'
    
    
  )

    
    
    
    COMMENT 'Daily order counts and amounts by status.'
    
  

    
  as
    select
    cast(source_inserted_at as date) as order_date,
    count(*) as total_orders,
    count(case when status = 'PLACED' then 1 end) as placed_orders,
    count(case when status = 'COMPLETED' then 1 end) as completed_orders,
    cast(sum(case when status = 'COMPLETED' then amount else 0 end)
        as decimal(28,2)) as completed_sales_amount,
    count(case when status = 'CANCELLED' then 1 end) as cancelled_orders,
    cast(sum(case when status = 'CANCELLED' then amount else 0 end)
        as decimal(28,2)) as cancelled_order_amount,
    count(case when status = 'REFUNDED' then 1 end) as refunded_orders,
    cast(sum(case when status = 'REFUNDED' then amount else 0 end)
        as decimal(28,2)) as refunded_order_amount
from `retail_analytics_poc_strm_tab`.`dbt_retail_streaming_poc`.`fact_orders`
group by cast(source_inserted_at as date)

      
